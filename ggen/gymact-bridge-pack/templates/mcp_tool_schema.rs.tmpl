---
to: "src/chatgptgym_mcp_tools.rs"
shape:
  - shapes/profile.shacl.ttl
sparql:
  ops: |
    PREFIX dct: <http://purl.org/dc/terms/>
    PREFIX sosa: <http://www.w3.org/ns/sosa/>
    SELECT ?id ?consequence_class
    WHERE {
      ?cap a sosa:Procedure ; dct:title ?id ; dct:type ?class .
      BIND(IF(CONTAINS(STR(?class), "consequence:do"), "Do", "Read") AS ?consequence_class)
    }
    ORDER BY ?id
---
//! GENERATED by ggen. Tool schemas manufacture intents; they grant no authority.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub struct McpToolSchema { pub name: &'static str, pub consequence_class: &'static str }

pub const MCP_TOOLS: &[McpToolSchema] = &[
{% for row in ops -%}
    McpToolSchema { name: "chatgptgym.{{ row.id }}", consequence_class: "{{ row.consequence_class }}" },
{% endfor -%}
];

pub fn lookup_mcp_tool(name: &str) -> Option<&'static McpToolSchema> {
    MCP_TOOLS.iter().find(|tool| tool.name == name)
}
