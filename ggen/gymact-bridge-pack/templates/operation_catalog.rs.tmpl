---
to: "src/chatgptgym_operation_catalog.rs"
shape:
  - ggen/gymact-bridge-pack/shapes/profile.shacl.ttl
sparql:
  ops: |
    PREFIX dct: <http://purl.org/dc/terms/>
    PREFIX sosa: <http://www.w3.org/ns/sosa/>
    SELECT ?id ?consequence_class
    WHERE {
      ?cap a sosa:Procedure ; dct:title ?id ; dct:type ?class .
      BIND(IF(CONTAINS(STR(?class), "consequence:do"), "Do", "Read") AS ?consequence_class)
    }
    ORDER BY ?id
---
//! GENERATED by ggen from ChatGPTGym's admitted capability graph. Do not edit.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub struct Operation { pub id: &'static str, pub consequence_class: &'static str }

pub const OPERATIONS: &[Operation] = &[
{% for row in ops -%}
    Operation { id: "{{ row.id }}", consequence_class: "{{ row.consequence_class }}" },
